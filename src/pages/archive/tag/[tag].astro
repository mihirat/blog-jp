---
import type { CollectionEntry } from 'astro:content'
import PostList from '../../../components/PostList.astro'
import Layout from '../../../layouts/Layout.astro'
import { getSortedPosts, getTaxonomy } from '../../../utils/content-utils'

export async function getStaticPaths() {
  const posts = await getSortedPosts()
  return getTaxonomy(posts, 'tags').map(({ name }) => ({
    params: { tag: name },
    props: { posts: posts.filter(post => post.data.tags?.includes(name)) },
  }))
}
interface Props {
  posts: CollectionEntry<'posts'>[]
}
const { posts } = Astro.props
const { tag } = Astro.params
---
<Layout title={`タグ: ${tag}`} heading={`タグ: #${tag}`}>
  <p class="muted">{posts.length}記事 · <a href="/archive/">すべての記事</a></p>
  <PostList posts={posts} />
</Layout>
