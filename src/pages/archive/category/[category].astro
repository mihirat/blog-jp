---
import type { CollectionEntry } from 'astro:content'
import PostList from '../../../components/PostList.astro'
import Layout from '../../../layouts/Layout.astro'
import { getSortedPosts, getTaxonomy } from '../../../utils/content-utils'

export async function getStaticPaths() {
  const posts = await getSortedPosts()
  return getTaxonomy(posts, 'category')
    .filter(({ name }) => name !== 'uncategorized')
    .map(({ name }) => ({
      params: { category: name },
      props: { posts: posts.filter(post => post.data.category === name) },
    }))
}
interface Props {
  posts: CollectionEntry<'posts'>[]
}
const { posts } = Astro.props
const { category } = Astro.params
---
<Layout title={`カテゴリ: ${category}`} heading={`カテゴリ: ${category}`}>
  <p class="muted">{posts.length}記事 · <a href="/archive/">すべての記事</a></p>
  <PostList posts={posts} />
</Layout>
