---
import PostList from '../../components/PostList.astro'
import Layout from '../../layouts/Layout.astro'
import { getSortedPosts } from '../../utils/content-utils'
const posts = await getSortedPosts()
const years = [
  ...new Set(posts.map(post => post.data.published.getUTCFullYear())),
]
---
<Layout title="アーカイブ">
  <h1 class="visually-hidden">アーカイブ</h1>
  {years.map(year => <section class="archive-year" aria-label={`${year}年の記事`}>
    <h2>{year}</h2>
    <PostList posts={posts.filter(post => post.data.published.getUTCFullYear() === year)} />
  </section>)}
</Layout>
