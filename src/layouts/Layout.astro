---
import '../styles/global.css'
import { Image } from 'astro:assets'
import defaultOgImage from '../assets/images/banner.png'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import { siteConfig } from '../config'
import { generateOgImageUrl } from '../utils/ogp-image.mjs'

interface Props {
  title?: string
  description?: string
  article?: boolean
  prev?: string
  next?: string
  heading?: string
}
const {
  title,
  description = siteConfig.subtitle,
  article = false,
  prev,
  next,
  heading,
} = Astro.props
const pageTitle = title
  ? `${title} - ${siteConfig.title}`
  : `${siteConfig.title} - ${siteConfig.subtitle}`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage =
  generateOgImageUrl(
    title || siteConfig.title,
    import.meta.env.PUBLIC_CLOUDINARY_CLOUD_NAME,
  ) || new URL(defaultOgImage.src, Astro.site).href
---
<!doctype html>
<html lang={siteConfig.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={siteConfig.author} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={siteConfig.title} href="/rss.xml" />
    {prev && <link rel="prev" href={prev} />}
    {next && <link rel="next" href={next} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={siteConfig.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <GoogleAnalytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <header class="site-header">
      <div class="container">
        <div class="header-branding">
          <Image class="site-banner" src={defaultOgImage} width={520} widths={[320, 640, 1040]} sizes="(max-width: 480px) calc((100vw - 2rem) * 1.18), 520px" alt="" loading="eager" />
        </div>
        <div class="header-controls">
          <div class="site-brand">
            <a class="site-title" href="/">{siteConfig.title}</a>
            <p class="site-description">{siteConfig.subtitle}</p>
          </div>
          <nav class="primary-nav" aria-label="メインナビゲーション">
            <a href="/" aria-current={Astro.url.pathname === '/' || /^\/\d+\/$/.test(Astro.url.pathname) ? 'page' : undefined}>Home</a>
            <a href="/archive/" aria-current={Astro.url.pathname.startsWith('/archive/') ? 'page' : undefined}>Archive</a>
            <a href="/about/" aria-current={Astro.url.pathname === '/about/' ? 'page' : undefined}>About</a>
            <a href="/rss.xml">RSS</a>
          </nav>
          {heading && <h1 class="page-heading" title={heading}>{heading}</h1>}
        </div>
      </div>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <p>© {new Date().getFullYear()} {siteConfig.author}</p>
      <nav aria-label="著者のリンク">
        {siteConfig.links.map(link => <a href={link.url}>{link.name}</a>)}
        <a href="/license.txt">Code license</a>
      </nav>
    </footer>
  </body>
</html>
