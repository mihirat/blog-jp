---
// Keep the environment variables used by the existing deployment.
const client = import.meta.env.GATSBY_GOOGLE_ADSENSE_ID
const slot = import.meta.env.GATSBY_GOOGLE_ADSENSE_SLOT_ID
---
{import.meta.env.PROD && client && slot && <aside class="advertisement" aria-label="広告">
  <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${client}`} crossorigin="anonymous"></script>
  <ins class="adsbygoogle" style="display:block;text-align:center" data-ad-layout="in-article" data-ad-format="fluid" data-ad-client={client} data-ad-slot={slot}></ins>
  <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
</aside>}
