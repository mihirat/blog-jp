---
import { getCategoryUrl, getTagUrl } from '../utils/url-utils'
interface Props {
  published: Date
  tags?: string[]
  category?: string
}
const { published, tags = [], category } = Astro.props
const date = published.toISOString().slice(0, 10)
---
<div class="post-meta">
  <time datetime={date}>{date}</time>
  {category && <a class="category-label" href={getCategoryUrl(category)}>{category}</a>}
  {tags.length > 0 && <ul class="tag-list" aria-label="タグ">
    {tags.map(tag => <li><a href={getTagUrl(tag)}>#{tag}</a></li>)}
  </ul>}
</div>
